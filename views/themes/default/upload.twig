{% extends "layouts/main.twig" %}

{% block content %}
<h2 class="text-3xl font-bold text-gray-800 dark:text-gray-200 mb-6">File Uploader</h2>
<p class="text-gray-600 dark:text-gray-400 mb-6">Select multiple files to see the real-time upload progress.</p>

<form method="post" action="{{ base_url }}/upload" enctype="multipart/form-data"
      data-rhapsody-upload="{{ base_url }}/upload" class="max-w-xl">
    {{ csrf_field() }}

    <label for="documents" class="block text-gray-700 dark:text-gray-300 font-bold mb-2">
        Documents (JPG, PNG, PDF - Max 5MB each)
    </label>
    <input type="file" name="documents" id="documents" multiple required
           accept="image/jpeg,image/png,application/pdf"
           class="block w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 dark:file:bg-blue-900 file:text-blue-700 dark:file:text-blue-300 hover:file:bg-blue-100 dark:hover:file:bg-blue-800 cursor-pointer">

    <div class="mt-6">
        <button type="submit"
                class="bg-blue-500 hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-800 disabled:opacity-50 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">
            Upload Files
        </button>
    </div>

    <ul data-upload-list class="mt-8 space-y-4"></ul>
</form>

<style>
    [data-upload-list] { list-style: none; padding: 0; }
    [data-upload-list] [data-role="name"]   { font-size: .875rem; font-weight: 500; }
    [data-upload-list] progress             { width: 100%; height: .625rem; margin-top: .25rem; }
    [data-upload-list] [data-role="status"] { font-size: .75rem; margin-top: .25rem; opacity: .8; }
    [data-upload-list] [data-state="success"] [data-role="status"] { color: #16a34a; opacity: 1; }
    [data-upload-list] [data-state="error"]   [data-role="status"] { color: #dc2626; opacity: 1; }
</style>

<script src="{{ base_url }}/js/rhapsody-uploader.js" defer></script>
{% endblock %}
