# --- Enable the URL rewriting engine
RewriteEngine On

# --- Optional: If your site is in a subdirectory, uncomment and set it here
# RewriteBase /my-awesome-app/

# --- Redirect Trailing Slashes If Not a Folder (Good for Router consistency)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# --- Explicit allowlist of the ONLY parts of the project root that are
# meant to be served as static files directly. Everything else in the
# project root — .env, vendor/, storage/, a stray sitemap.xml someone
# committed by accident, etc. — must NEVER be served this way, even
# though the files physically exist on disk.
#
# Previously this fell through to a blanket "if the file exists, serve it"
# rule.
RewriteCond %{REQUEST_URI} ^/public/ [OR]
RewriteCond %{REQUEST_URI} ^/favicon\.ico$
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# --- Everything else always routes through index.php, regardless of
# whether a same-named file happens to exist at the project root. This is
# what makes framework/module routes authoritative over the filesystem.
RewriteRule ^ index.php [L]
