# Rhapsody Environment Configuration
# This file is for your local settings and should NOT be committed to git.

APP_URL=""

# Your company name (to be used in emails, announcements, etc)
APP_NAME=""

# If your website is installed in a subdirectory, enter the name of the 
# subdirectory, preceeded by a forward slash("/subdir-name"). Otherwise,
# just leave this blank
APP_BASE_URL=""

# Can be 'development' or 'production'
# MAKE SURE TO SET THIS TO PRODUCTION ON A LIVE SITE
APP_ENV="development"

# Change the active theme here. Make sure that the name matches
# the folder name stored in /views/themes/ directory
APP_THEME="default"

# Hash used for cookies
# Generate your own unique 32 or 64 character key using:
# php -r "echo bin2hex(random_bytes(64));"
APP_KEY=""

# Database
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASS=""
DB_DRIVER="" # Supported databases: mysql, pgsql, sqlite, or sqlsrv

# Set true for dev server, false for production 
VITE_DEV_SERVER=true
VITE_PORT=5173

# Enable / disable lazy loading of services
LAZY_LOADING_ENABLED=true

# This can be 'file' or 'redis'. Leave this set to 'file'
# if you do not have access to Redis on your webhosting
CACHE_DRIVER=file

# Typical Redis defaults. Set a password.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# DDoS protection
DDOS_ENABLED=true

# Maximum allowed requests within the time window
DDOS_MAX_REQUESTS=60

# Time window in seconds
DDOS_TIME_WINDOW=60

# How long (in seconds) to block the IP after the limit is exceeded.
# Default is 300 (5 minutes)
DDOS_BLOCK_DURATION=300

# Disable protection for these IP addresses (typically dev environments).
# Separate each IP with a comma.
DDOS_WHITELIST=127.0.0.1,::1,192.168.1.100

# Immediately block these IPs. Separate each IP with a comma.
DDOS_BLACKLIST=

# --- MAILER CONFIGURATION ---
MAIL_TRANSPORT="smtp"
MAIL_HOST=""
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME=""

# If you want to receive updates / notifications from Rhapsody Framework
MAIL_ADMIN_EMAIL = ""

# --- MODULE FAILURE ALERTS ---
# Fired by NotifyDevsOfModuleFailure when an installed module fails to boot
# (bad config, incompatible version, a thrown exception, etc). Set either or
# both; if both are blank no alert is sent (failures are still error_log()'d
# and visible via ModuleRegistry::failures()). Re-alerts for the same module
# are limited to once per 24h.
MODULE_ALERT_EMAIL=""

# Slack/Discord/Teams incoming webhook URL
MODULE_ALERT_WEBHOOK_URL=""

# Gemini AI
# Get your API key here:    https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here

# Gemini's model lineup updates fairly often; this setting should be updated
# as necessary. If you want to be notified via email if compatibility issues 
# are encountered, make sure the admin email above is set.
GEMINI_MODEL=gemini-3.7-flash

# Google login
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost/your-site-name/auth/google/callback

# Facebook login
FACEBOOK_APP_ID=your-app-id
FACEBOOK_APP_SECRET=your-app-secret
FACEBOOK_REDIRECT_URI=http://localhost/your-site-name/auth/facebook/callback

RECAPTCHA_SITE_KEY="your_site_key_here"
RECAPTCHA_SECRET_KEY="your_secret_key_here"

PAYMENT_GATEWAY=Stripe
PAYMENT_CURRENCY=USD

STRIPE_API_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

PAYPAL_CLIENT_ID=...
PAYPAL_SECRET=...
PAYPAL_TEST_MODE=true
